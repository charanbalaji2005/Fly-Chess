# Where the Python simulation service is reachable.
# Used by vite.config.ts to proxy /api during development.
VITE_API_TARGET=http://127.0.0.1:8000

# Optional: call the API directly instead of through the dev proxy.
# Leave unset for same-origin requests (the default, and what production wants).
# VITE_API_BASE=http://127.0.0.1:8000

# Optional: load a real Drosophila mesh instead of the procedural body.
# Drop the file in web/public/models/ and point this at it. glb is preferred.
# The mesh is normalised into the frame documented in src/three/flyAnatomy.ts.
# VITE_FLY_MODEL_URL=/models/drosophila.glb
